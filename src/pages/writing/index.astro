---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WritingArchiveItem from "@/components/writing/WritingArchiveItem.astro";
import { siteConfig } from "@/site.config";
import { getBlogPosts, getTagEntries } from "@/lib/content";
import { buildTagLookup, getTagCounts, getTagHref, getTagLabel } from "@/lib/tags";
import "@/styles/writing-index.css";

const [posts, tags] = await Promise.all([getBlogPosts(), getTagEntries()]);
const tagLookup = buildTagLookup(tags);
const tagCounts = getTagCounts(posts);
const browseTopics = ["elections", "political-parties", "effective-parties", "electoral-systems", "mathematical-modelling", "taxation"]
  .filter((tag) => tagCounts.has(tag));
---

<BaseLayout
  title="Writing"
  description="Essays and explainers on elections, representation, and the ideas behind them."
>
  <section class="writing-archive" aria-labelledby="writing-title" data-filter-shell>
    <h1 id="writing-title" class="sr-only">Writing</h1>

    <div class="archive-layout">
      <div class="archive-heading">
        <h2 id="writing-list-title" data-results-heading>Latest Writing</h2>
        <p role="status" aria-live="polite" aria-atomic="true" data-results-count>
          {posts.length} {posts.length === 1 ? "article" : "articles"}
        </p>
      </div>

      <form class="archive-search" role="search" data-search-form hidden>
        <label for="writing-search" class="sr-only">Search writing</label>
        <div class="archive-search__field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" />
          </svg>
          <input id="writing-search" name="q" type="search" placeholder="Search writing" autocomplete="off" aria-controls="writing-list" data-writing-search />
        </div>
      </form>

      <div class="archive-results" id="writing-list" aria-labelledby="writing-list-title">
        <div class="archive-list" data-post-list>
          {posts.map((post, index) => <WritingArchiveItem post={post} tagLookup={tagLookup} eager={index === 0} />)}
        </div>
        <div class="archive-empty" data-empty-state hidden>
          <h3>No Articles Found</h3>
          <p>Try another word or explore a topic from the archive.</p>
          <button type="button" class="archive-text-link" data-clear-search>Clear search</button>
        </div>
      </div>

      <aside class="archive-sidebar" aria-label="Explore more writing">
        <nav class="archive-topics" aria-labelledby="archive-topics-title">
          <h2 id="archive-topics-title">Explore Topics</h2>
          <ul>
            {browseTopics.map((tag) => (
              <li><a href={getTagHref(tag)}>
                <span>{getTagLabel(tag, tagLookup)}</span>
                <span class="archive-topic-count" aria-label={`${tagCounts.get(tag)} ${tagCounts.get(tag) === 1 ? "article" : "articles"}`}>{tagCounts.get(tag)}</span>
              </a></li>
            ))}
          </ul>
          <a class="archive-text-link" href="/tags/">All topics</a>
        </nav>
        <section class="archive-follow" aria-labelledby="archive-follow-title">
          <h2 id="archive-follow-title">Follow Me Online</h2>
          <ul class="archive-follow__links">
            <li>
              <a class="archive-social-link" href={siteConfig.social.bluesky} aria-label="Bluesky" title="Bluesky" target="_blank" rel="noreferrer">
                <i class="bi bi-bluesky" aria-hidden="true"></i>
              </a>
            </li>
            <li>
              <a class="archive-social-link" href={siteConfig.social.linkedin} aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="noreferrer">
                <i class="bi bi-linkedin" aria-hidden="true"></i>
              </a>
            </li>
          </ul>
        </section>
      </aside>
    </div>
  </section>

  <script>
    const shell = document.querySelector("[data-filter-shell]");

    if (shell) {
      const form = shell.querySelector<HTMLFormElement>("[data-search-form]");
      const input = shell.querySelector<HTMLInputElement>("[data-writing-search]");
      const cards = Array.from(shell.querySelectorAll<HTMLElement>("[data-post-card]"));
      const count = shell.querySelector<HTMLElement>("[data-results-count]");
      const heading = shell.querySelector<HTMLElement>("[data-results-heading]");
      const empty = shell.querySelector<HTMLElement>("[data-empty-state]");
      const clear = shell.querySelector<HTMLButtonElement>("[data-clear-search]");

      function applySearch() {
        const query = input?.value.toLowerCase().trim() ?? "";
        const words = query.split(/\s+/).filter(Boolean);
        let visible = 0;

        for (const card of cards) {
          const matches = words.every((word) => (card.dataset.search ?? "").includes(word));
          card.hidden = !matches;
          if (matches) visible += 1;
        }

        if (count) count.textContent = `${visible} ${visible === 1 ? "article" : "articles"}`;
        if (heading) heading.textContent = query ? "Search Results" : "Latest Writing";
        if (empty) empty.hidden = visible > 0;
      }

      if (form) form.hidden = false;
      form?.addEventListener("submit", (event) => { event.preventDefault(); applySearch(); });
      input?.addEventListener("input", applySearch);
      clear?.addEventListener("click", () => {
        if (input) { input.value = ""; input.focus(); }
        applySearch();
      });
      window.addEventListener("pageshow", applySearch);
      applySearch();
    }
  </script>
</BaseLayout>
