---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleShare from "@/components/writing/ArticleShare.astro";
import ArticleTable from "@/components/writing/ArticleTable.astro";
import PaperGasHero from "@/components/writing/PaperGasHero.astro";
import { siteConfig } from "@/site.config";
import { getBlogPosts, getRelatedPosts, getTagEntries } from "@/lib/content";
import { buildTagLookup, getTagHref, getTagLabel } from "@/lib/tags";
import { formatDate, getReadingTime } from "@/lib/format";
import { getWritingArtwork } from "@/lib/writingArtwork";
import "@/styles/article.css";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const allPosts = await getBlogPosts();
const relatedPosts = getRelatedPosts(post, allPosts);
const suggestedPosts = relatedPosts.length
  ? relatedPosts
  : allPosts.filter((entry) => entry.slug !== post.slug).slice(0, 3);
const tagLookup = buildTagLookup(await getTagEntries());
const artwork = getWritingArtwork(post.slug);
const canonical = new URL(`/writing/${post.slug}/`, Astro.site).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.date).toISOString(),
  author: {
    "@type": "Person",
    name: siteConfig.name
  },
  keywords: post.data.tags.join(", ")
};
---

<BaseLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.summary}
  structuredData={structuredData}
>
  <article class="article-page" aria-labelledby="article-title">
    <header class="article-heading">
      <h1 id="article-title">{post.data.title}</h1>
      <p class="article-deck">{post.data.summary}</p>
    </header>

    <div class="article-media">
      {post.slug === "effective-parties-as-collisions" ? (
        <PaperGasHero poster={artwork.image} />
      ) : <Image
        src={artwork.image}
        alt=""
        class="article-media__image"
        style={`object-position: ${artwork.objectPosition};`}
        widths={[480, 768, 1024, 1280, 1536]}
        sizes="(min-width: 1376px) 1280px, (min-width: 1051px) calc(100vw - 96px), (min-width: 601px) calc(100vw - 64px), calc(100vw - 48px)"
        loading="eager"
        fetchpriority="high"
      />}
      <div class="article-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{getReadingTime(post.body)}</span>
      </div>
      {post.data.updatedDate && (
        <p class="article-updated">Updated <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></p>
      )}
    </div>

    <div class="article-reading">
      <aside class="article-topics article-rail" aria-labelledby="article-topics-title">
        <h2 id="article-topics-title" class="article-rail__title">Topics</h2>
        <ul>
          {post.data.tags.map((tag) => (
            <li><a href={getTagHref(tag)}>{getTagLabel(tag, tagLookup)}</a></li>
          ))}
        </ul>
      </aside>

      <aside class="article-share article-rail" aria-labelledby="article-share-title">
        <h2 id="article-share-title" class="article-rail__title">Share</h2>
        <ArticleShare title={post.data.title} url={canonical} />
      </aside>

      <div class="prose-editorial article-prose">
        <Content components={{ table: ArticleTable }} />
      </div>
    </div>

    {suggestedPosts.length > 0 && (
      <section class="article-related" aria-labelledby="related-title">
        <h2 id="related-title">{relatedPosts.length ? "Related reading" : "More writing"}</h2>
        <ul>
          {suggestedPosts.map((entry) => {
            const relatedArtwork = getWritingArtwork(entry.slug);
            return (
              <li>
                <a class="article-related__link" href={`/writing/${entry.slug}/`}>
                  <Image src={relatedArtwork.image} alt="" widths={[320, 640, 960]} sizes="(min-width: 1051px) 350px, (min-width: 601px) 45vw, calc(100vw - 48px)" loading="lazy" />
                  <h3>{entry.data.title}</h3>
                </a>
                <p>{entry.data.summary}</p>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
