---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CopyLinkButton from "@/components/ui/CopyLinkButton.astro";
import { siteConfig } from "@/site.config";
import { getBlogPosts, getRelatedPosts } from "@/lib/content";
import { formatDate, getReadingTime } from "@/lib/format";
import { getWritingArtwork } from "@/lib/writingArtwork";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const allPosts = await getBlogPosts();
const relatedPosts = getRelatedPosts(post, allPosts);
const hasRelatedPosts = relatedPosts.length > 0;
const artwork = getWritingArtwork(post.slug);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.date).toISOString(),
  author: {
    "@type": "Person",
    name: siteConfig.name
  },
  keywords: post.data.tags.join(", ")
};
---

<BaseLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.summary}
  structuredData={structuredData}
>
  <section class="section-space">
    <div class:list={["page-shell gap-8", hasRelatedPosts ? "grid lg:grid-cols-[minmax(0,1fr)_300px]" : ""]}>
      <article class:list={["space-y-8", !hasRelatedPosts && "max-w-4xl"]}>
        <header class="writing-hero">
          <Image
            src={artwork.image}
            alt=""
            class="writing-hero__image"
            style={`object-position: ${artwork.objectPosition};`}
            widths={[768, 1024, 1536]}
            sizes="(min-width: 1024px) 760px, 100vw"
            loading="eager"
          />
          <div class="writing-hero__copy">
            <p class="writing-hero__meta">
              {formatDate(post.data.date)} · {getReadingTime(post.body)}
            </p>
            <h1 class="writing-hero__title">{post.data.title}</h1>
            <p class="writing-hero__summary">{post.data.summary}</p>
          </div>
        </header>

        <div class="flex flex-wrap items-center justify-end gap-4 text-sm text-muted">
          {post.data.updatedDate && <span>Updated {formatDate(post.data.updatedDate)}</span>}
          <CopyLinkButton />
        </div>

        <div class="surface pt-7 sm:pt-8">
          <div class="prose-editorial">
            <Content />
          </div>
        </div>
      </article>

      {hasRelatedPosts && (
        <aside class="editorial-sidebar space-y-6">
          <div class="space-y-4">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">Related posts</p>
            <ul class="space-y-4">
              {relatedPosts.map((entry) => (
                <li class="border-t panel-rule pt-4 first:border-t-0 first:pt-0">
                  <a href={`/writing/${entry.slug}/`} class="font-semibold text-ink hover:text-accent">
                    {entry.data.title}
                  </a>
                  <p class="mt-2 text-sm leading-6 text-ink">{entry.data.summary}</p>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </section>
</BaseLayout>
