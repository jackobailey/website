---
import HomeArticle from "@/components/writing/HomeArticle.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBlogPosts } from "@/lib/content";
import { siteConfig } from "@/site.config";

const [leadPost, ...recentPosts] = (await getBlogPosts()).slice(0, 3);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: Astro.site?.toString() ?? "https://example.com",
  description: siteConfig.description
};
---

<BaseLayout structuredData={structuredData}>
  <h1 class="sr-only">Latest writing by {siteConfig.name}</h1>
  <div class="home-layout">
    <section class="home-intro" aria-labelledby="home-intro-title">
      <img
        src="/images/jack-bailey-coral.jpeg"
        alt="Portrait of Jack Bailey"
        width="1122"
        height="1402"
        loading="eager"
        class="home-intro__portrait"
      />
      <div class="home-intro__copy">
        <h2 id="home-intro-title">Hi, I&apos;m Jack Bailey.</h2>
        <p>
          I&apos;m a political scientist at the{" "}
          <a href="https://www.humanities.manchester.ac.uk/politics/">University of Manchester</a>{" "}
          and a Co-Director of the{" "}
          <a href="https://www.britishelectionstudy.com/">British Election Study</a>.
        </p>
        <p>
          I study elections and electoral systems, and I welcome requests for comments and collaboration.
        </p>
        <p>
          You can follow me on <a href="https://bsky.app/profile/jack-bailey.co.uk">Bluesky</a>{" "}
          and <a href="https://www.linkedin.com/in/jack-bailey-776221227/">LinkedIn</a>, and find links to my research on{" "}
          <a href="https://scholar.google.com/citations?user=82kKRKIAAAAJ&amp;hl=en">Google Scholar</a>.
        </p>
        <a href="/about/" class="home-intro__more">More about me <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="home-writing" aria-label="Latest writing">
      {leadPost && <HomeArticle post={leadPost} featured />}
      {recentPosts.length > 0 && (
        <div class="home-writing__recent">
          {recentPosts.map((post) => <HomeArticle post={post} />)}
        </div>
      )}
      <a href="/writing/" class="home-writing__more">All writing <span aria-hidden="true">→</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .home-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 48px;
    width: min(calc(100% - 96px), 1120px);
    margin: 28px auto 16px;
  }

  .home-intro {
    padding-right: 32px;
    border-right: 1px solid var(--line-color);
  }

  .home-intro__portrait {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.1;
    object-fit: cover;
    object-position: 50% 42%;
  }

  .home-intro h2 {
    margin: 22px 0 14px;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .home-intro p {
    margin: 0 0 14px;
    font-size: 16px;
    line-height: 1.55;
  }

  .home-intro p a { color: #f76f5c; text-decoration: none; }
  .home-intro p a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .home-intro__more,
  .home-writing__more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    font-size: 14px;
    font-weight: 500;
  }

  .home-intro__more:hover,
  .home-writing__more:hover { color: #f76f5c; }

  .home-layout a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .home-writing__recent {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line-color);
  }

  .home-writing__more { margin-top: 10px; }

  @media (max-width: 1050px) {
    .home-layout {
      width: min(calc(100% - 84px), 740px);
      grid-template-columns: minmax(0, 1fr);
    }

    .home-intro { display: none; }
    .home-writing__recent { gap: 28px; }
  }

  @media (max-width: 600px) {
    .home-layout {
      width: calc(100% - 48px);
      margin-top: 24px;
    }

    .home-writing__recent { gap: 16px; }
  }
</style>
