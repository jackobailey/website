---
import WritingCard from "@/components/writing/WritingCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBlogPosts } from "@/lib/content";
import { siteConfig } from "@/site.config";

const posts = await getBlogPosts();

function getCopyWeight(post: (typeof posts)[number]) {
  return post.data.title.length * 1.6 + post.data.summary.length;
}

const fiveCardCandidates = posts.slice(0, 5);
const compactFiveCardCandidates = fiveCardCandidates.slice(2);
const canUseFiveCards =
  fiveCardCandidates.length === 5 &&
  compactFiveCardCandidates.every((post) => getCopyWeight(post) <= 126) &&
  fiveCardCandidates.reduce((total, post) => total + getCopyWeight(post), 0) <= 560;
const homepagePosts = posts.slice(0, canUseFiveCards ? 5 : 4);
const homepageCardCount = homepagePosts.length;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: Astro.site?.toString() ?? "https://example.com",
  description: siteConfig.description
};
---

<BaseLayout structuredData={structuredData}>
  <section class="page-shell py-6 sm:py-8">
    <h1 class="sr-only">Featured writing by {siteConfig.name}</h1>
    <div
      class:list={["home-writing-grid", `home-writing-grid--${homepageCardCount}`]}
      data-home-card-count={homepageCardCount}
    >
      {homepagePosts.map((post, index) => (
        <WritingCard post={post} position={index + 1} eager={index < 2} />
      ))}
    </div>
  </section>
</BaseLayout>
