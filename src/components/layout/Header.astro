---
import { siteConfig } from "@/site.config";
import "@fontsource/ubuntu-sans/latin-500.css";
import "@fontsource/ubuntu-sans/latin-600.css";

const pathname = `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const navItems = [
  { href: "/writing/", label: "Writing" },
  { href: "/about/", label: "About" }
];
---

<header class="masthead">
  <a href="/" class="masthead__name" aria-label={`${siteConfig.name} home`}>JACK BAILEY</a>
  <nav aria-label="Primary navigation">
    <ul class="masthead__nav">
      {navItems.map((item) => {
        const isActive = pathname.startsWith(item.href) || (item.href === "/writing/" && pathname.startsWith("/tags/"));
        return (
          <li>
            <a href={item.href} class="masthead__link" aria-current={isActive ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<style>
  /* Share the reference menu without depending on either page's content styles. */
  .masthead {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: min(calc(100% - 96px), 1120px);
    margin-inline: auto;
    padding: 32px 0 16px;
    border-bottom: 1px solid #dedede;
    color: #111;
    font: 400 16px/1.5 "Ubuntu Sans", Arial, sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  a:focus-visible {
    outline: 2px solid #111;
    outline-offset: 4px;
  }

  .masthead__name {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: .02em;
    line-height: 1.3;
  }

  .masthead__nav {
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .masthead__link {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .masthead__link:hover { color: #f76f5c; }

  .masthead__link[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: #f76f5c;
    text-decoration-thickness: 2px;
    text-underline-offset: 7px;
  }

  @media (max-width: 1050px) {
    .masthead { width: min(calc(100% - 84px), 740px); }
  }

  @media (max-width: 600px) {
    .masthead {
      display: block;
      width: calc(100% - 48px);
      padding-top: 26px;
      padding-bottom: 0;
    }
    .masthead__nav { margin-top: 15px; gap: 18px; justify-content: space-between; }
    .masthead__link { font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    a { transition: none; }
  }
</style>
