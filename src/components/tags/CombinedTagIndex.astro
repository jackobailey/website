---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/ui/PageIntro.astro";
import { getTagEntries } from "@/lib/content";
import { getTagHref } from "@/lib/tags";
import { getCombinedTagCounts, getTaggedContentEntries } from "@/lib/taggedContent";

const [entries, tags] = await Promise.all([getTaggedContentEntries(), getTagEntries()]);
const tagCounts = getCombinedTagCounts(entries);
const tagsWithEntries = tags.filter((tag) => (tagCounts.total.get(tag.slug) ?? 0) > 0);

function formatCount(count: number, singular: string, plural: string) {
  return `${count} ${count === 1 ? singular : plural}`;
}

---

<BaseLayout
  title="Topics"
  description="Browse articles by topic."
>
  <PageIntro
    eyebrow="Topics"
    title="Browse by topic"
  />

  <section class="page-shell pb-14 sm:pb-20">
    <div class="grid gap-8 md:grid-cols-2">
      {tagsWithEntries.map((tag) => (
        <article class="surface surface-strong pt-6">
          <p class="text-sm font-semibold text-ink">
            {formatCount(tagCounts.total.get(tag.slug) ?? 0, "post", "posts")}
          </p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink">
            <a href={getTagHref(tag.slug)} class="hover:text-accent">
              {tag.data.name}
            </a>
          </h2>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
