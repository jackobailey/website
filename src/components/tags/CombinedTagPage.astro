---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/ui/PageIntro.astro";
import TagList from "@/components/ui/TagList.astro";
import { getTagEntries } from "@/lib/content";
import { formatDate, getReadingTime } from "@/lib/format";
import { buildTagLookup, getTagHref, getTagLabel } from "@/lib/tags";
import type { TaggedContentEntry } from "@/lib/taggedContent";

interface Props {
  entries: TaggedContentEntry[];
  tag: CollectionEntry<"tags">;
}

const { entries, tag } = Astro.props;
const tagLookup = buildTagLookup(await getTagEntries());
---

<BaseLayout
  title={tag.data.seoTitle ?? `${tag.data.name} entries`}
  description={tag.data.seoDescription ?? tag.data.description}
>
  <PageIntro eyebrow="Tag" title={tag.data.name} description={tag.data.description} />

  <section class="page-shell pb-14 sm:pb-20">
    <div class="grid gap-8 md:grid-cols-2">
      {entries.map((item) => (
        <article class="surface surface-strong pt-6">
          <div class="min-w-0">
            <p class="eyebrow mt-2">
              {item.collectionLabel} · {formatDate(item.entry.data.date)}
            </p>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink">
              <a href={item.href} class="hover:text-accent">
                {item.entry.data.title}
              </a>
            </h2>
            <p class="mt-3 text-base leading-8 text-ink">{item.entry.data.summary}</p>
            <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-3 text-sm text-muted">
              <span class="shrink-0">{getReadingTime(item.entry.body)}</span>
              <TagList
                items={item.entry.data.tags.map((slug) => ({
                  slug,
                  label: getTagLabel(slug, tagLookup),
                  href: getTagHref(slug)
                }))}
              />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
