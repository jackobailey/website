---
import Image from '@/components/writing/ArtworkImage.astro';
import poster from '@/assets/writing/ward-election-tour.svg';
---

<ward-map-tour>
  <Image src={poster} class="ward-tour__poster" loading="eager" fetchpriority="high"
    alt="A map of all 7,993 census wards in Great Britain, coloured by the party with the largest estimated 2024 vote share. The animation visits Manchester, London, Glasgow, Edinburgh, Cardiff, Birmingham and Bristol. Colours show modelled estimates, not counted ward results or winning probabilities." />
  <canvas width="1280" height="720" aria-hidden="true"></canvas>
  <div class="ward-tour__label" aria-hidden="true">
    <span>2024 · Ward estimates</span>
    <strong data-tour-label>Great Britain</strong>
  </div>
</ward-map-tour>

<style>
  ward-map-tour { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: #f1f0eb; contain: layout paint; }
  .ward-tour__poster, canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  canvas { opacity: 0; pointer-events: none; }
  ward-map-tour[data-ready] canvas { opacity: 1; }
  ward-map-tour[data-ready] .ward-tour__poster { opacity: 0; }
  .ward-tour__label { position: absolute; left: 3.5%; bottom: 6%; padding: .7rem 1rem; color: #202b32; background: #f1f0ebed; }
  .ward-tour__label span { display: block; font-size: clamp(.55rem, .85vw, .75rem); font-weight: 500; letter-spacing: .11em; text-transform: uppercase; }
  .ward-tour__label strong { display: block; margin-top: .35rem; font-size: clamp(1rem, 2.1vw, 1.8rem); line-height: 1.1; letter-spacing: -.025em; }
  @media (max-width: 600px) { .ward-tour__label { padding: .4rem .55rem; left: 2%; bottom: 4%; } }
  @media print { canvas { display: none; } ward-map-tour[data-ready] .ward-tour__poster { opacity: 1; } }
</style>

<script>
  import { WARD_TOUR, wardTourFrame, type TourStop, type MapBounds } from '@/lib/wardTour';
  import { buildWardTourMap, wardRingPath, type WardTourTopology } from '@/lib/wardTourScene';
  import type { Estimates } from '@/components/ward2024/data';

  interface PaintedWard { path: Path2D; bounds: MapBounds; colour: string; }

  class WardMapTour extends HTMLElement {
    private time = 0;
    private frame = 0;
    private previous: number | null = null;
    private lastPaint = 0;
    private visible = false;
    private printing = false;
    private loaded = false;
    private started = false;
    private abort?: AbortController;
    private resize?: ResizeObserver;
    private intersection?: IntersectionObserver;
    private motion = matchMedia('(prefers-reduced-motion: reduce)');
    private print = matchMedia('print');
    private canvas!: HTMLCanvasElement;
    private ctx!: CanvasRenderingContext2D;
    private label!: HTMLElement;
    private stops: TourStop[] = [];
    private wards: PaintedWard[] = [];
    private countryPaths = new Map<string, Path2D>();
    private lastCamera = '';

    connectedCallback() {
      this.abort = new AbortController();
      const { signal } = this.abort;
      this.canvas = this.querySelector('canvas')!;
      this.label = this.querySelector('[data-tour-label]')!;
      const context = this.canvas.getContext('2d', { alpha: false });
      if (!context) return;
      this.ctx = context;
      this.motion.addEventListener('change', () => this.schedule(), { signal });
      this.print.addEventListener('change', () => this.schedule(), { signal });
      document.addEventListener('visibilitychange', () => this.schedule(), { signal });
      window.addEventListener('beforeprint', () => { this.printing = true; this.schedule(); }, { signal });
      window.addEventListener('afterprint', () => { this.printing = false; this.schedule(); }, { signal });
      this.resize = new ResizeObserver(() => this.fit());
      this.resize.observe(this);
      this.intersection = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        this.schedule();
      });
      this.intersection.observe(this);
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.frame);
      this.frame = 0; this.previous = null; this.visible = false;
      this.abort?.abort(); this.resize?.disconnect(); this.intersection?.disconnect();
      this.started = false;
      this.removeAttribute('data-running');
    }

    private async load() {
      if (this.started || this.loaded) return;
      this.started = true;
      const signal = this.abort!.signal;
      try {
        const read = async (url: string) => {
          const response = await fetch(url, { signal });
          if (!response.ok) throw new Error(`Could not load ${url}`);
          return response.json();
        };
        const [topology, estimates] = await Promise.all([
          read('/data/ward2024/wards.topo.json'), read('/data/ward2024/estimates.json'),
        ]) as [WardTourTopology, Estimates];
        if (signal.aborted) return;
        const map = buildWardTourMap(topology, estimates);
        const wards: PaintedWard[] = [];
        const countryPaths = new Map<string, Path2D>();
        for (let index = 0; index < map.wards.length; index++) {
          const ward = map.wards[index];
          const path = new Path2D(wardRingPath(ward.rings));
          wards.push({ path, bounds: ward.bounds, colour: ward.colour });
          if (!countryPaths.has(ward.colour)) countryPaths.set(ward.colour, new Path2D());
          countryPaths.get(ward.colour)!.addPath(path);
          // Keep search, scrolling and navigation responsive while preparing paths.
          if (index % 256 === 0) {
            await new Promise(resolve => setTimeout(resolve, 0));
            if (signal.aborted) return;
          }
        }
        this.stops = map.stops; this.wards = wards; this.countryPaths = countryPaths;
        this.loaded = true;
        this.fit();
        this.setAttribute('data-ready', '');
        this.schedule();
      } catch {
        // A network, data or Canvas failure leaves the complete vector still visible.
        if (!signal.aborted) this.setAttribute('data-fallback', '');
      }
    }

    private fit() {
      if (!this.loaded) return;
      const width = this.getBoundingClientRect().width;
      if (!width) return;
      const ratio = Math.min(devicePixelRatio || 1, 3);
      this.canvas.width = Math.round(width * ratio);
      this.canvas.height = Math.round(width * ratio * WARD_TOUR.height / WARD_TOUR.width);
      this.lastCamera = '';
      this.draw(this.motion.matches || this.print.matches || this.printing ? 0 : this.time);
    }

    private schedule() {
      cancelAnimationFrame(this.frame);
      this.frame = 0; this.previous = null; this.lastPaint = 0;
      const staticView = this.motion.matches || this.print.matches || this.printing;
      const running = this.isConnected && this.visible && !document.hidden && !staticView;
      if (running && !this.loaded) void this.load();
      this.toggleAttribute('data-running', running && this.loaded);
      if (this.loaded) this.draw(staticView ? 0 : this.time);
      if (running && this.loaded) this.frame = requestAnimationFrame(this.tick);
    }

    private tick = (now: number) => {
      if (this.previous !== null) this.time += (now - this.previous) / 1000;
      this.previous = now;
      // 30fps is ample for a slow map tour and avoids unnecessary vector painting.
      if (now - this.lastPaint >= 1000 / 30) { this.draw(this.time); this.lastPaint = now; }
      this.frame = requestAnimationFrame(this.tick);
    };

    private draw(time: number) {
      const { camera, label, labelOpacity } = wardTourFrame(time, this.stops);
      if (this.label.textContent !== label) this.label.textContent = label;
      this.label.style.opacity = String(labelOpacity);
      this.dataset.location = label;
      this.dataset.tourTime = time.toFixed(3);
      const key = `${camera.x},${camera.y},${camera.scale}`;
      if (key === this.lastCamera) return;
      this.lastCamera = key;
      const ctx = this.ctx;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.fillStyle = WARD_TOUR.background;
      ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
      const ratio = this.canvas.width / WARD_TOUR.width;
      ctx.setTransform(ratio * camera.scale, 0, 0, ratio * camera.scale,
        ratio * (WARD_TOUR.width / 2 - camera.x * camera.scale),
        ratio * (WARD_TOUR.height / 2 - camera.y * camera.scale));
      ctx.lineJoin = 'round';
      const detailed = camera.scale > this.stops[0].camera.scale * 3;
      const zoom = camera.scale / this.stops[0].camera.scale;
      const borderOpacity = Math.min(.65, .15 + Math.log(zoom) * .15);
      ctx.strokeStyle = `rgba(255,255,255,${borderOpacity})`;
      ctx.lineWidth = .42 / camera.scale;
      if (!detailed) {
        for (const [colour, path] of this.countryPaths) {
          ctx.fillStyle = colour;
          ctx.fill(path, 'evenodd'); ctx.stroke(path);
        }
      } else {
        const halfWidth = WARD_TOUR.width / (2 * camera.scale);
        const halfHeight = WARD_TOUR.height / (2 * camera.scale);
        for (const ward of this.wards) {
          const [left, top, right, bottom] = ward.bounds;
          if (right < camera.x - halfWidth || left > camera.x + halfWidth || bottom < camera.y - halfHeight || top > camera.y + halfHeight) continue;
          ctx.fillStyle = ward.colour;
          ctx.fill(ward.path, 'evenodd'); ctx.stroke(ward.path);
        }
      }
    }
  }

  if (!customElements.get('ward-map-tour')) customElements.define('ward-map-tour', WardMapTour);
</script>
