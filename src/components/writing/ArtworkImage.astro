---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"img">, "src" | "width" | "height" | "srcset"> {
  src: ImageMetadata;
  alt: string;
}

const { src, alt, ...attributes } = Astro.props;
// Offer Retina-sized files, capped by Astro at the original's native resolution.
const widths = [360, 480, 640, 768, 960, 1280, 1536, 1920, 2560];
---

{src.format === "svg" ? (
  <img {...attributes} src={src.src} width={src.width} height={src.height} alt={alt} decoding="async" />
) : (
  <Image {...attributes} src={src} alt={alt} widths={widths} quality={95} format="webp" />
)}
