---
import { renderMmpSeatsScene } from "@/lib/mmpSeatsScene";
---

<mmp-seats>
  <Fragment set:html={renderMmpSeatsScene()} />
</mmp-seats>

<style>
  mmp-seats { display: block; position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: #faf7f0; }
  mmp-seats > :global(svg) { display: block; width: 100%; height: 100%; }
  @media (prefers-reduced-motion: reduce) {
    mmp-seats :global([data-seat]) { opacity: 1 !important; }
  }
  @media print {
    mmp-seats :global([data-seat]) { opacity: 1 !important; }
  }
</style>

<script>
  import { createMmpSeats, stepMmpSeats, MMP_SEAT_POSITIONS, type MmpSeat } from "@/lib/mmpSeats";

  class MmpSeats extends HTMLElement {
    private visible = false;
    private abort?: AbortController;
    private observer?: IntersectionObserver;
    private motion = matchMedia("(prefers-reduced-motion: reduce)");
    private frame = 0;
    private previous = 0;
    private seats: MmpSeat[] = [];
    private elements: SVGGElement[] = [];
    private uses: SVGUseElement[] = [];
    private group!: SVGGElement;

    connectedCallback() {
      this.abort = new AbortController();
      const { signal } = this.abort;
      this.seats = createMmpSeats();
      this.group = this.querySelector("[data-seats]")!;
      this.elements = Array.from(this.querySelectorAll("[data-seat]"));
      this.uses = this.elements.map(element => element.querySelector("use")!);
      this.draw();
      this.motion.addEventListener("change", () => this.schedule(), { signal });
      document.addEventListener("visibilitychange", () => this.schedule(), { signal });
      this.observer = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        this.schedule();
      });
      this.observer.observe(this);
      this.setAttribute("data-ready", "");
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.frame);
      this.frame = 0;
      this.previous = 0;
      this.abort?.abort();
      this.observer?.disconnect();
      this.removeAttribute("data-running");
    }

    private schedule() {
      cancelAnimationFrame(this.frame);
      this.frame = 0;
      this.previous = 0;
      const running = this.visible && !document.hidden && !this.motion.matches;
      this.toggleAttribute("data-running", running);
      if (running) this.frame = requestAnimationFrame(this.tick);
    }

    private tick = (now: number) => {
      if (this.previous) stepMmpSeats(this.seats, Math.min((now - this.previous) / 1000, .05));
      this.previous = now;
      this.draw();
      this.frame = requestAnimationFrame(this.tick);
    };

    private draw() {
      let reordered = false;
      this.seats.forEach((seat, index) => {
        const element = this.elements[index];
        element.style.opacity = seat.opacity.toFixed(4);
        if (element.dataset.slot !== String(seat.slot)) {
          const position = MMP_SEAT_POSITIONS[seat.slot];
          element.setAttribute("transform", `translate(${position.x.toFixed(2)} ${position.y.toFixed(2)})`);
          element.dataset.slot = String(seat.slot);
          reordered = true;
        }
        if (element.dataset.color !== String(seat.color)) {
          this.uses[index].setAttribute("href", `#mmp-chair-${seat.color}`);
          element.dataset.color = String(seat.color);
        }
      });
      // Preserve front-to-back occlusion when a hidden chair changes position.
      if (reordered) this.seats.map((seat, index) => ({ slot: seat.slot, index }))
        .sort((a, b) => MMP_SEAT_POSITIONS[a.slot].depth - MMP_SEAT_POSITIONS[b.slot].depth || a.slot - b.slot)
        .forEach(({ index }) => this.group.append(this.elements[index]));
    }
  }
  if (!customElements.get("mmp-seats")) customElements.define("mmp-seats", MmpSeats);
</script>
